# Template for backend.hcl (gitignored). The state bucket is created once, manually,
# in the account-regional namespace for us-east-2:
#   export AWS_PROFILE=deadlock-tracker
#   ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
#   STATE_BUCKET=deadlock-tracker-tfstate-$ACCOUNT-us-east-2-an
#   aws s3api create-bucket --bucket $STATE_BUCKET --bucket-namespace account-regional \
#     --region us-east-2 --create-bucket-configuration LocationConstraint=us-east-2
#   aws s3api put-bucket-versioning --bucket $STATE_BUCKET \
#     --versioning-configuration Status=Enabled
bucket       = "deadlock-tracker-tfstate-<account-id>-us-east-2-an"
key          = "deadlock-tracker/terraform.tfstate"
region       = "us-east-2"
use_lockfile = true
encrypt      = true
