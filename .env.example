DT_SOURCE_BASE_URL=https://data.deadlock-api.com
DT_HEROES_URL=https://api.deadlock-api.com/v1/assets/heroes
DT_DOWNLOAD_CAP_MB=300
DT_WINDOW_DAYS=7
DT_SETTLE_LAG_HOURS=6
DT_MAX_GAP_MINUTES=30
